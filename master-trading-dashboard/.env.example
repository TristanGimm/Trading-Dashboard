# Copy to .env. NEVER commit .env or paste credentials into chat.
DASHBOARD_TIMEZONE=Europe/Berlin
DB_NAME=trading
DB_USER=trading
DB_PASSWORD=REPLACE_WITH_LONG_RANDOM_PASSWORD
# Local development only; Docker Compose sets these for the web service.
# PGHOST=127.0.0.1
# PGPORT=5432
# Locally uploads default to ./uploads; Docker Compose sets /app/uploads.
# UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=12
# Generate the hash with: npm run auth:hash
AUTH_USERNAME=replace-with-your-username
AUTH_PASSWORD_HASH=replace-with-scrypt-hash
AUTH_SECRET=replace-with-at-least-32-random-characters

# --- Sign in, registration and password reset -------------------------------
# AUTH_SECRET signs the session cookie (32+ characters). Required.
# The browser needs to know its own origin to build reset links.
APP_URL=http://127.0.0.1:3000

# Email delivery for password resets. Without SMTP the message is written to
# MAIL_DIR (a local outbox) and the API reports it as not delivered.
# MAIL_DIR=/app/mail
# MAIL_FROM="Trading Dashboard <no-reply@gimmholding.com>"
# SMTP_URL=smtps://user:password@smtp.example.com:465
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
